# Neon pooled connection string used by the running application.
DATABASE_URL=""

# Neon direct connection string used by Prisma CLI migrations.
DIRECT_URL=""

# Better Auth session encryption secret. Generate with: npx auth secret
BETTER_AUTH_SECRET=""

# Local URL for authentication callbacks (use the deployed URL in production).
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth credentials from Google Cloud Console.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
