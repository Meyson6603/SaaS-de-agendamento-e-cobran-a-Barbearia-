# Neon pooled connection string used by the running application.
DATABASE_URL=""

# Neon direct connection string used by Prisma CLI migrations.
DIRECT_URL=""

# Better Auth session encryption secret. Generate with: npx auth secret
BETTER_AUTH_SECRET=""

# Comma-separated, verified email addresses allowed to access /admin.
PLATFORM_ADMIN_EMAILS=""

# Authentication callback URL. Use the deployed HTTPS URL in production.
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth credentials from Google Cloud Console.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Mercado Pago server-side access token for online Pix/card checkout.
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""

# Public URL used by Mercado Pago to return the customer and send webhooks.
APP_URL="http://localhost:3000"

# Resend credentials for transactional e-mails (free tier available).
RESEND_API_KEY=""
EMAIL_FROM="Navalha <onboarding@resend.dev>"

# Set to true only for local testing without an e-mail provider. Use false in production.
OTP_DEV_MODE="false"

# Optional future integration for phone verification by SMS and WhatsApp.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SMS_FROM=""
TWILIO_WHATSAPP_FROM=""
