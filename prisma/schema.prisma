generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  MANAGER
  PROFESSIONAL
}

enum Weekday {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum AvailabilityExceptionType {
  AVAILABLE
  BLOCKED
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum BookingEventType {
  CANCELLED
  RESCHEDULED
}

enum NotificationType {
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  BOOKING_RESCHEDULED
  PAYMENT_RECEIVED
}

enum PaymentMethod {
  PIX
  CASH
  CARD_ON_SITE
  ONLINE_CARD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  phone         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  accounts    Account[]
  sessions    Session[]
  memberships Membership[]
  bookings    Booking[] @relation("BookingCustomer")
  bookingEvents BookingEvent[] @relation("BookingEventActor")
  notifications Notification[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  accountId         String
  providerId        String
  accessToken       String? @db.Text
  refreshToken      String? @db.Text
  idToken           String? @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope             String?
  password          String? @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Barbershop {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  phone     String?
  timezone  String   @default("America/Sao_Paulo")
  currency  String   @default("BRL")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships            Membership[]
  professionals          Professional[]
  services               Service[]
  availabilityExceptions AvailabilityException[]
  bookings               Booking[]
  notifications          Notification[]
}

model Membership {
  id        String         @id @default(cuid())
  shopId    String
  userId    String
  role      MembershipRole
  createdAt DateTime       @default(now())

  shop         Barbershop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  professional Professional?

  @@unique([shopId, userId])
  @@unique([shopId, id])
  @@index([userId])
}

model Professional {
  id           String   @id @default(cuid())
  shopId       String
  membershipId String   @unique
  displayName  String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  shop                   Barbershop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  membership             Membership              @relation(fields: [shopId, membershipId], references: [shopId, id], onDelete: Cascade)
  services               ProfessionalService[]
  weeklyAvailability     WeeklyAvailability[]
  availabilityExceptions AvailabilityException[]
  bookings               Booking[]

  @@unique([shopId, membershipId])
  @@unique([shopId, id])
  @@index([shopId, isActive])
}

model Service {
  id              String   @id @default(cuid())
  shopId          String
  name            String
  description     String?
  durationMinutes Int
  price           Decimal  @db.Decimal(10, 2)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  shop          Barbershop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  professionals ProfessionalService[]
  bookings      Booking[]

  @@unique([shopId, id])
  @@index([shopId, isActive])
}

model ProfessionalService {
  shopId         String
  professionalId String
  serviceId      String

  professional Professional @relation(fields: [shopId, professionalId], references: [shopId, id], onDelete: Cascade)
  service      Service      @relation(fields: [shopId, serviceId], references: [shopId, id], onDelete: Cascade)

  @@id([shopId, professionalId, serviceId])
  @@index([shopId, serviceId])
}

model WeeklyAvailability {
  id             String  @id @default(cuid())
  shopId         String
  professionalId String
  weekday        Weekday
  startMinute    Int
  endMinute      Int

  professional Professional @relation(fields: [shopId, professionalId], references: [shopId, id], onDelete: Cascade)

  @@unique([professionalId, weekday, startMinute])
  @@index([shopId, professionalId, weekday])
}

model AvailabilityException {
  id             String                    @id @default(cuid())
  shopId         String
  professionalId String
  type           AvailabilityExceptionType @default(BLOCKED)
  startsAt       DateTime                  @db.Timestamptz(3)
  endsAt         DateTime                  @db.Timestamptz(3)
  reason         String?
  createdAt      DateTime                  @default(now())

  shop         Barbershop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  professional Professional @relation(fields: [shopId, professionalId], references: [shopId, id], onDelete: Cascade)

  @@index([shopId, professionalId, startsAt, endsAt])
}

model Booking {
  id                      String        @id @default(cuid())
  shopId                  String
  professionalId          String
  serviceId               String
  customerId              String
  status                  BookingStatus @default(CONFIRMED)
  startsAt                DateTime      @db.Timestamptz(3)
  endsAt                  DateTime      @db.Timestamptz(3)
  serviceNameSnapshot     String
  serviceDurationSnapshot Int
  servicePriceSnapshot    Decimal       @db.Decimal(10, 2)
  customerNote            String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  shop         Barbershop   @relation(fields: [shopId], references: [id], onDelete: Restrict)
  professional Professional @relation(fields: [shopId, professionalId], references: [shopId, id], onDelete: Restrict)
  service      Service      @relation(fields: [shopId, serviceId], references: [shopId, id], onDelete: Restrict)
  customer     User         @relation("BookingCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  payment      Payment?
  events       BookingEvent[]
  notifications Notification[]

  @@index([shopId, startsAt])
  @@index([shopId, status, startsAt])
  @@index([professionalId, startsAt, endsAt])
  @@index([customerId, startsAt])
}

model Payment {
  id        String         @id @default(cuid())
  bookingId String         @unique
  method    PaymentMethod?
  status    PaymentStatus  @default(PENDING)
  amount    Decimal        @db.Decimal(10, 2)
  provider  String?
  providerReference String? @unique
  checkoutUrl String?
  paidAt    DateTime?      @db.Timestamptz(3)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
}

model BookingEvent {
  id               String           @id @default(cuid())
  bookingId        String
  actorId          String
  type             BookingEventType
  previousStartsAt DateTime?        @db.Timestamptz(3)
  previousEndsAt   DateTime?        @db.Timestamptz(3)
  newStartsAt      DateTime?        @db.Timestamptz(3)
  newEndsAt        DateTime?        @db.Timestamptz(3)
  createdAt        DateTime         @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actor   User    @relation("BookingEventActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([bookingId, createdAt])
  @@index([actorId, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  shopId    String
  bookingId String?
  type      NotificationType
  title     String
  message   String
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop    Barbershop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  booking Booking?   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([bookingId, createdAt])
}
